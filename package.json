{
  "name": "color-prism",
  "version": "1.1.3",
  "description": "Simple color manipulation functions",
  "type": "commonjs",
  "main": "index.js",
  "module": "dist/color-prism.esm.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/color-prism.esm.mjs",
      "require": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/color-prism.js",
    "dist/color-prism.min.js",
    "dist/color-prism.esm.mjs"
  ],
  "scripts": {
    "test": "mocha ./src/**/*.spec.js",
    "build": "npm run build:esm && npm run build:min",
    "build:esm": "cp src/color-prism.esm.js dist/color-prism.esm.mjs",
    "build:min": "uglifyjs --compress --mangle --output dist/color-prism.min.js -- src/color-prism.js",
    "prepublish": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metadeta96/color-prism.git"
  },
  "keywords": [
    "color",
    "prism",
    "colour",
    "functions",
    "rgb",
    "rgba",
    "hsl",
    "cmyk"
  ],
  "author": "metadeta96",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/metadeta96/color-prism/issues"
  },
  "homepage": "https://github.com/metadeta96/color-prism#readme",
  "devDependencies": {
    "chai": "^5.1.0",
    "mocha": "^10.4.0",
    "uglify-js": "^3.17.4"
  }
}
